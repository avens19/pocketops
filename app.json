{
  "expo": {
    "name": "PocketOps",
    "slug": "pocketops",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketops",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "primaryColor": "#E8590C",
    "ios": {
      "bundleIdentifier": "com.andrewovens.pocketops",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "PocketOps connects to your SigNoz server. If it runs on your local network, this lets the app reach it."
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.andrewovens.pocketops",
      "adaptiveIcon": {
        "backgroundColor": "#0E1013",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1013",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo resolves module classes by name from JS, so R8 sees no reference to them.\n-keep class expo.modules.** { *; }\n-keep interface expo.modules.** { *; }\n\n# React Native bridge/JNI surfaces are reached from C++ and from JS by name.\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.hermes.** { *; }\n\n# Reanimated, gesture-handler and screens register natives reflectively.\n-keep class com.swmansion.** { *; }",
            "enableMinifyInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-edge-to-edge-system-bars",
      "./plugins/with-gradle-jvm-args"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8545604c-4e75-41bb-8ec3-d2b4ef53a89e"
      }
    },
    "owner": "avens19s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8545604c-4e75-41bb-8ec3-d2b4ef53a89e",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
